<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A964BDA8-1DDD-40A2-96B4-E3F0694E282D}</ProjectGuid>
    <RootNamespace>ProtoLib</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="..\strandwire.config.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\strandwire.props" />
  </ImportGroup>
  <!--
    Generated code: warnings are turned off here. This is the one allowed exception to the rule
    that individual projects carry no compiler options (see strandwire.props).
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <CustomBuild>
      <Command>if not exist "$(NetSysGenDir)" mkdir "$(NetSysGenDir)"
"$(ProtocExe)" --cpp_out="$(NetSysGenDir)." -I "$(ProjectDir)." "%(FullPath)"</Command>
      <Message>protoc %(Filename)%(Extension)</Message>
      <Outputs>$(NetSysGenDir)%(Filename).pb.cc;$(NetSysGenDir)%(Filename).pb.h</Outputs>
      <AdditionalInputs>$(ProtocExe)</AdditionalInputs>
    </CustomBuild>
  </ItemDefinitionGroup>
  <ItemGroup>
    <CustomBuild Include="chat.proto" />
    <CustomBuild Include="error_code.proto" />
    <CustomBuild Include="server_config.proto" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(NetSysGenDir)chat.pb.cc" />
    <ClCompile Include="$(NetSysGenDir)error_code.pb.cc" />
    <ClCompile Include="$(NetSysGenDir)server_config.pb.cc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="NetSysCheckProtobuf" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ProtocExe)')"
           Text="protobuf is not installed for $(Configuration). Run: powershell -ExecutionPolicy Bypass -File tools\build_protobuf.ps1  (expected $(ProtocExe))" />
  </Target>
</Project>
